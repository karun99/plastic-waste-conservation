# OpenRouter API key - get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Any model slug from https://openrouter.ai/models that supports chat completions.
# Default is set in lib/openrouter.js if this is unset.
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional: sent as HTTP-Referer to OpenRouter for attribution.
NEXT_PUBLIC_SITE_URL=https://plastic-waste-conservation.vercel.app
